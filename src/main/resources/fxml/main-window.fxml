<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ospreydcs.dp.gui.MainController">
   <top>
      <MenuBar fx:id="menuBar" styleClass="navbar, navbar-default">
         <menus>
            <Menu text="File">
               <items>
                  <MenuItem fx:id="connectionMenuItem" disable="true" onAction="#onConnection" text="Connection" />
                  <MenuItem fx:id="preferencesMenuItem" disable="true" onAction="#onPreferences" text="Preferences" />
                  <SeparatorMenuItem />
                  <MenuItem fx:id="exitMenuItem" onAction="#onExit" text="Exit" />
               </items>
            </Menu>
            <Menu text="Ingest">
               <items>
                  <MenuItem fx:id="generateMenuItem" disable="true" onAction="#onGenerate" text="Generate" />
                  <MenuItem fx:id="importMenuItem" onAction="#onImport" text="Import" />
               </items>
            </Menu>
            <Menu text="Metadata">
               <items>
                  <MenuItem fx:id="pvMetadataCreateMenuItem" onAction="#onCreatePvMetadata" text="PV" />
                  <MenuItem fx:id="machineConfigCreateMenuItem" onAction="#onCreateMachineConfiguration" text="Machine Configuration" />
               </items>
            </Menu>
            <Menu text="Explore">
               <items>
                  <MenuItem fx:id="dataMenuItem" disable="true" onAction="#onData" text="Data" />
                  <MenuItem fx:id="pvStatsMenuItem" disable="true" onAction="#onPvStats" text="PV Statistics" />
                  <MenuItem fx:id="pvMetadataExploreMenuItem" disable="true" onAction="#onPvMetadataExplore" text="PV Metadata" />
                  <MenuItem fx:id="providerMetadataMenuItem" disable="true" onAction="#onProviderMetadata" text="Providers" />
                  <MenuItem fx:id="datasetsMenuItem" disable="true" onAction="#onDatasets" text="Datasets" />
                  <MenuItem fx:id="annotationsMenuItem" disable="true" onAction="#onAnnotations" text="Annotations" />
                  <MenuItem fx:id="configurationsExploreMenuItem" disable="true" onAction="#onConfigurationsExplore" text="Machine Configurations" />
                  <MenuItem fx:id="sampleStatusesMenuItem" disable="true" onAction="#onSampleStatuses" text="Sample Statuses" />
                  <MenuItem fx:id="dataEventsMenuItem" disable="true" onAction="#onDataEvents" text="Data Events" />
               </items>
            </Menu>
         </menus>
      </MenuBar>
   </top>
   <center>
      <StackPane fx:id="contentPane" styleClass="container-fluid">
         <!-- Content will be loaded dynamically -->
      </StackPane>
   </center>
   <bottom>
      <ToolBar styleClass="navbar, navbar-default">
         <Label fx:id="statusLabel" styleClass="navbar-text" text="Ready" />
         <Region HBox.hgrow="ALWAYS" />
         <!-- text is replaced at runtime by the bound MainViewModel.connectionStatusText, which
              carries AppConfiguration.describe() once the mode is known -->
         <Label fx:id="connectionStatusLabel" styleClass="navbar-text" text="Connecting..." />
      </ToolBar>
   </bottom>
</BorderPane>