<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" styleClass="form-container">
   <Label styleClass="section-header" text="Column Metadata" />
   <GridPane hgap="10" vgap="10">
      <columnConstraints>
         <ColumnConstraints minWidth="160" prefWidth="160" />
         <ColumnConstraints hgrow="ALWAYS" />
      </columnConstraints>

      <Label text="Provenance Source:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
      <TextField fx:id="provenanceSourceField" promptText="Origin of the data, e.g. an NTTable/column identifier" GridPane.columnIndex="1" GridPane.rowIndex="0" />

      <Label text="Provenance Process:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
      <TextField fx:id="provenanceProcessField" promptText="Processing applied to the source data, e.g. normalization" GridPane.columnIndex="1" GridPane.rowIndex="1" />

      <com.ospreydcs.dp.gui.component.TagsListComponent fx:id="columnTagsComponent" labelText="Column Tags:" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="2" />

      <com.ospreydcs.dp.gui.component.AttributesListComponent fx:id="columnAttributesComponent" labelText="Column Attributes:" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="3" />
   </GridPane>
</VBox>
